{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "timezone": "Europe/Helsinki",
  "schedule": ["* 0-6 1 * *"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 0-6 1 * *"] },
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"], "minimumReleaseAge": null },
  "packageRules": [
    {
      "description": "Payloadin paketit aina samaan versioon",
      "matchPackageNames": ["payload", "@payloadcms/**"],
      "groupName": "Payload"
    },
    {
      "description": "Astro ja Tailwind",
      "matchPackageNames": ["astro", "@astrojs/**", "tailwindcss", "@tailwindcss/**"],
      "groupName": "Astro"
    },
    {
      "description": "Muut pienet päivitykset yhteen PR:ään",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!payload", "!@payloadcms/**", "!astro", "!@astrojs/**"],
      "groupName": "Pienet päivitykset"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
