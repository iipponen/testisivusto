---
import type { Page } from '@cms/types'
import { Image } from 'astro:assets'

import { asMedia, linkHref } from '../lib/payload'

type Block = Extract<Page['layout'][number], { blockType: 'cards' }>
const { block } = Astro.props as { block: Block }
---

<section class="mx-auto max-w-6xl px-4 py-12">
  {(block.heading || block.intro) && (
    <div class="mb-8 max-w-2xl space-y-3">
      {block.heading && <h2 class="text-3xl font-semibold">{block.heading}</h2>}
      {block.intro && <p class="text-muted-foreground">{block.intro}</p>}
    </div>
  )}
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      block.items?.map((item) => {
        const image = asMedia(item.image)
        const href = linkHref(item.link)
        return (
          <li class="relative flex flex-col gap-3 rounded-lg border border-border p-6">
            {image && (
              <Image src={image.url!} alt={image.alt} width={image.width!} height={image.height!} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, 100vw" class="aspect-video w-full rounded-md object-cover" />
            )}
            <h3 class="text-xl font-semibold">
              {href ? <a href={href} class="after:absolute after:inset-0 hover:text-primary">{item.title}</a> : item.title}
            </h3>
            {item.text && <p class="text-muted-foreground">{item.text}</p>}
          </li>
        )
      })
    }
  </ul>
</section>
