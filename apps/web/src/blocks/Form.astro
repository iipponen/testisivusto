---
// Payloadin Form Builder -lomake. Lähetys selaimesta suoraan Payloadiin
// (/api/form-submissions); Payload tallentaa vastauksen ja lähettää postin.
import type { Page } from '@cms/types'

import { Section, SectionContainer, SectionTitle } from '../components/section'
import { Button } from '../components/starwind/button'
import { Input } from '../components/starwind/input'
import { Label } from '../components/starwind/label'
import { NativeSelect, NativeSelectOption } from '../components/starwind/native-select'
import { Textarea } from '../components/starwind/textarea'
import { asForm, PAYLOAD_URL } from '../lib/payload'
import { richTextToHTML } from '../lib/richtext'

type Block = Extract<Page['layout'][number], { blockType: 'form' }>
const { block } = Astro.props as { block: Block }
const form = asForm(block.form)
---

{
  form && (
    <Section class="py-12 md:py-16">
      <SectionContainer>
        <div class="flex max-w-xl flex-col gap-6">
          {block.heading && <SectionTitle>{block.heading}</SectionTitle>}
          <form
            class="payload-form flex flex-col gap-5"
            data-form-id={form.id}
            data-endpoint={`${PAYLOAD_URL}/api/form-submissions`}
            data-redirect={form.confirmationType === 'redirect' ? form.redirect?.url : undefined}
            novalidate
          >
            {form.fields?.map((field) => {
              const id = `f${form.id}-${'name' in field ? field.name : field.id}`
              const label = 'label' in field ? `${field.label ?? ''}${'required' in field && field.required ? ' *' : ''}` : ''
              switch (field.blockType) {
                case 'text':
                case 'email':
                case 'number':
                  return (
                    <div class="flex flex-col gap-2">
                      <Label for={id}>{label}</Label>
                      <Input
                        id={id}
                        name={field.name}
                        type={field.blockType}
                        required={!!field.required}
                        autocomplete={field.blockType === 'email' ? 'email' : field.name === 'nimi' ? 'name' : undefined}
                      />
                    </div>
                  )
                case 'textarea':
                  return (
                    <div class="flex flex-col gap-2">
                      <Label for={id}>{label}</Label>
                      <Textarea id={id} name={field.name} rows={5} required={!!field.required} />
                    </div>
                  )
                case 'select':
                  return (
                    <div class="flex flex-col gap-2 [&_[data-slot=native-select-wrapper]]:w-full">
                      <Label for={id}>{label}</Label>
                      <NativeSelect id={id} name={field.name} required={!!field.required}>
                        <NativeSelectOption value="">Valitse…</NativeSelectOption>
                        {field.options?.map((o) => <NativeSelectOption value={o.value}>{o.label}</NativeSelectOption>)}
                      </NativeSelect>
                    </div>
                  )
                case 'checkbox':
                  // Natiivi valintaruutu: Starwindin Checkbox ei läpäise
                  // axe-tarkistusta (nested-interactive, label ilman kohdetta).
                  return (
                    <div class="flex items-start gap-3">
                      <input
                        id={id}
                        name={field.name}
                        type="checkbox"
                        value="true"
                        required={!!field.required}
                        class="mt-0.5 size-5 shrink-0 rounded-sm border-input text-primary focus:ring-3 focus:ring-outline/50 focus:ring-offset-0"
                      />
                      <Label for={id}>{label}</Label>
                    </div>
                  )
                case 'message':
                  return <div class="prose-content" set:html={richTextToHTML(field.message)} />
                default:
                  return null
              }
            })}
            {/* Roskapostiansa: ihminen ei näe eikä täytä tätä. */}
            <div aria-hidden="true" class="hidden">
              <label>
                Älä täytä
                <input name="_hp" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <p class="form-error hidden text-error" role="alert">
              Lähetys epäonnistui. Tarkista pakolliset kentät ja yritä uudelleen.
            </p>
            <Button type="submit" variant="primary" size="lg" class="self-start">
              {form.submitButtonLabel || 'Lähetä'}
            </Button>
          </form>
          <div class="form-success prose-content hidden" role="status" tabindex="-1" set:html={richTextToHTML(form.confirmationMessage)} />
        </div>
      </SectionContainer>
    </Section>
  )
}

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.payload-form')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const error = form.querySelector<HTMLElement>('.form-error')!
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
      error.classList.add('hidden')
      if (!form.reportValidity()) return
      const data = new FormData(form)
      if (data.get('_hp')) return
      data.delete('_hp')
      const submissionData = [...data.entries()].map(([field, value]) => ({ field, value: String(value) }))
      for (const box of form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')) {
        if (!box.checked) submissionData.push({ field: box.name, value: 'false' })
      }
      button.disabled = true
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ form: Number(form.dataset.formId), submissionData }),
        })
        if (!res.ok) throw new Error(String(res.status))
        if (form.dataset.redirect) {
          location.href = form.dataset.redirect
          return
        }
        const success = form.nextElementSibling as HTMLElement
        form.classList.add('hidden')
        success.classList.remove('hidden')
        success.focus()
      } catch {
        error.classList.remove('hidden')
      } finally {
        button.disabled = false
      }
    })
  }
</script>
