---
import type { Page } from '@cms/types'

import { richTextToHTML } from '../lib/richtext'

type Block = Extract<Page['layout'][number], { blockType: 'content' }>
const { block } = Astro.props as { block: Block }
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <div class="prose-content" set:html={richTextToHTML(block.body)} />
</section>
