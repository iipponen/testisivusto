---
// Asettelu Fulldev UI:n cta-lohkoista (MIT, github.com/fulldotdev/ui).
import type { Page } from '@cms/types'

import { Section, SectionContainer, SectionTitle } from '../components/section'
import { Button } from '../components/starwind/button'
import { linkHref } from '../lib/payload'

type Block = Extract<Page['layout'][number], { blockType: 'cta' }>
const { block } = Astro.props as { block: Block }
const href = linkHref(block.link)
---

<Section tone="primary">
  <SectionContainer class="flex flex-col items-center gap-6 text-center">
    <SectionTitle class="max-w-2xl">{block.heading}</SectionTitle>
    {block.text && <p class="max-w-xl text-lg text-pretty opacity-90">{block.text}</p>}
    {
      href && (
        <Button href={href} size="lg" class="bg-highlight text-highlight-foreground hover:bg-highlight/90">
          {block.link.label}
        </Button>
      )
    }
  </SectionContainer>
</Section>
