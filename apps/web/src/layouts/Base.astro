---
import type { Page, SiteSetting } from '@cms/types'
import { getImage } from 'astro:assets'

import { asMedia, linkHref } from '../lib/payload'
import '../styles/global.css'

interface Props {
  page: Page
  settings: SiteSetting
}
const { page, settings } = Astro.props

const title = page.seo?.title || (page.slug === 'etusivu' ? settings.siteName : `${page.title} – ${settings.siteName}`)
const description = page.seo?.description || settings.seo?.description || undefined
const shareMedia = asMedia(page.seo?.image) ?? asMedia(settings.seo?.image)
const shareImage = shareMedia
  ? new URL(
      (await getImage({ src: shareMedia.url!, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src,
      Astro.site,
    ).href
  : undefined
const current = Astro.url.pathname
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#sisalto" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-background focus:p-2">
      Siirry sisältöön
    </a>
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href={import.meta.env.BASE_URL} class="text-lg font-semibold">{settings.siteName}</a>
        {
          settings.navigation?.length ? (
            <nav aria-label="Päävalikko">
              <ul class="flex flex-wrap gap-x-6 gap-y-2">
                {settings.navigation.map((item) => {
                  const href = linkHref(item)
                  return (
                    <li>
                      <a
                        href={href}
                        class="hover:text-primary aria-[current=page]:font-semibold aria-[current=page]:text-primary"
                        aria-current={href && href.replace(/\/$/, '') === current.replace(/\/$/, '') ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </nav>
          ) : null
        }
      </div>
    </header>
    <main id="sisalto" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border bg-muted">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 text-sm text-muted-foreground sm:grid-cols-2">
        <div class="space-y-1">
          <p class="font-semibold text-foreground">{settings.siteName}</p>
          {settings.contact?.address && <p class="whitespace-pre-line">{settings.contact.address}</p>}
        </div>
        <div class="space-y-1 sm:text-right">
          {settings.contact?.email && <p><a class="hover:text-primary" href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a></p>}
          {settings.contact?.phone && <p><a class="hover:text-primary" href={`tel:${settings.contact.phone.replace(/\s/g, '')}`}>{settings.contact.phone}</a></p>}
          {settings.footerText && <p>{settings.footerText}</p>}
        </div>
      </div>
    </footer>
  </body>
</html>
