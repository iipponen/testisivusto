# Sivuston tuotanto-osoitteet (julkisia, commitoidaan). GitHub Actions
# käyttää näitä. Paikallisesti apps/web/.env ohittaa ne.
# Payloadin osoite: build hakee sisällön ja kuvat, selain lähettää lomakkeet.
PAYLOAD_URL=https://testisivusto-cms.rotas.fi
# Julkisen sivuston osoite (canonical, Open Graph).
SITE_URL=https://testisivusto.rotas.fi
# GitHub Pagesin projektipolku, jos omaa domainia ei ole (esim. /repo).
BASE_PATH=
