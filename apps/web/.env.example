# Kopioi: cp .env.example .env
# Payloadin osoite: build hakee sisällön ja kuvat, selain lähettää lomakkeet.
PUBLIC_PAYLOAD_URL=http://localhost:3000
# Julkisen sivuston osoite (canonical, sitemap, Open Graph).
SITE_URL=http://localhost:4321
# GitHub Pagesin projektipolku, jos omaa domainia ei vielä ole (esim. /repo).
BASE_PATH=
