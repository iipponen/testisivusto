# Kopioi: cp .env.example .env
# Paikallinen kehitys: pnpm db:up (compose.dev.yaml) → alla oleva URI toimii.
# Sorsalla: scripts/new-db.sh <asiakas>_cms (iipponen/postgres) antaa URI:n.
DATABASE_URI=postgres://cms:cms@127.0.0.1:54329/cms
# Pitkä satunnainen merkkijono: openssl rand -hex 32
PAYLOAD_SECRET=
# CMS:n oma osoite (admin, mediatiedostojen URLit).
SERVER_URL=http://localhost:3000
# Julkisen sivuston osoite(et) pilkulla eroteltuna: CORS lomakkeille.
SITE_URLS=http://localhost:4321

# --- Sähköposti (lomakkeet). Tyhjä SMTP_HOST → viestit vain lokiin. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=lomakkeet@rotas.fi
EMAIL_FROM_NAME=

# --- Julkaisu: Payload käynnistää sivuston buildin GitHubissa. ---
# Tyhjä → ei buildia (paikallinen kehitys).
GITHUB_REPO=
# Fine-grained token vain tähän repoon, Contents: Read and write.
GITHUB_DISPATCH_TOKEN=
