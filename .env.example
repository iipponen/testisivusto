# Sorsan .env (compose.yaml). Kopioi: cp .env.example .env && chmod 600 .env
COMPOSE_PROJECT_NAME=asiakas-cms
CMS_IMAGE=ghcr.io/iipponen/asiakas-sivusto-cms:latest
CMS_HOST=asiakas-cms.rotas.fi

# iipponen/postgres: scripts/new-db.sh asiakas_cms
DATABASE_URI=
# openssl rand -hex 32
PAYLOAD_SECRET=
SERVER_URL=https://asiakas-cms.rotas.fi
# Julkisen sivuston osoitteet (CORS lomakkeille), pilkulla eroteltuna.
SITE_URLS=https://asiakas.rotas.fi

# Brevo (haahka: ~/.config/brevo/smtp.env)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=lomakkeet@rotas.fi
EMAIL_FROM_NAME=

# Julkaisu käynnistää buildin: owner/repo ja fine-grained token vain
# siihen repoon (Contents: Read and write).
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
